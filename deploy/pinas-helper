#!/bin/bash
# Privilegiertes Hilfsskript für PiNAS. Wird vom Dienstbenutzer "pinas" per sudo aufgerufen
# und darf ausschließlich NAS-Benutzer und das NAS-Datenlaufwerk verwalten.
#   pinas-helper add-user NAME           (Passwort über stdin)
#   pinas-helper set-password NAME       (Passwort über stdin)
#   pinas-helper delete-user NAME
#   pinas-helper private-access NAME on|off  (Freigabe „Privat“ für diesen Benutzer ein/aus)
#   pinas-helper use-disk /dev/sdX format [folder|root]   (Platte löschen, ext4 anlegen, einhängen)
#   pinas-helper use-disk /dev/sdX1 keep [folder|root]    (vorhandene ext4-/NTFS-/exFAT-Partition einhängen)
#   pinas-helper set-layout folder|root     (Ordner-Aufteilung umstellen, siehe unten)
#   pinas-helper samba-config               (Samba-Freigaben neu schreiben)
#   pinas-helper samba-audit on|off         (Netzlaufwerk-Zugriffe ins Ereignis-Protokoll, Modul full_audit)
#   pinas-helper disk-sleep                 (NAS-Platte sofort in den Ruhezustand)
#   pinas-helper update-stage DATEI         (Update-Paket prüfen und bereitlegen, siehe pinas-update)
#   pinas-helper update-apply|update-rollback|update-discard
#   pinas-helper power shutdown|reboot|update-reboot|safe-shutdown|disk-off|disk-on|cancel
#   pinas-helper factory-reset keep|wipe    (Werkseinstellungen; wipe leert zusätzlich die Festplatte)
#
# Ordner-Aufteilung (PINAS_SHARED_MODE in /etc/default/pinas):
#   folder  „Gemeinsam“ = DATA/shared,  private Ordner in DATA/users/<name>
#   root    „Gemeinsam“ = ganze Platte (z. B. vom Windows-PC), private Ordner in DATA/.pinas/users/<name>
set -euo pipefail

GROUP="nasusers"
PRIVATE_GROUP="pinasprivat"  # nur Mitglieder sehen die Freigabe „Privat“
MARK="pinas-managed"
SETTINGS="/etc/default/pinas"
SAMBA_TEMPLATE="/usr/local/share/pinas/smb-pinas.conf.in"
PINAS_DATA="/srv/nas"
PINAS_SHARED_MODE="folder"
# shellcheck disable=SC1090
[[ -r "$SETTINGS" ]] && . "$SETTINGS"
DATA="$PINAS_DATA"

die() { echo "$*" >&2; exit 1; }

# ---------------------------------------------------------------- Benutzer

check_user_name() {
  [[ "$name" =~ ^[a-z][a-z0-9_-]{1,31}$ ]] || die "Ungültiger Benutzername"
  case "$name" in
    root|pinas|daemon|bin|sys|sync|games|man|lp|mail|news|uucp|proxy|www-data|backup|list|irc|nobody|sshd|avahi|nasusers)
      die "Reservierter Benutzername" ;;
  esac
  # Bestehende Systemkonten (UID < 1000), die nicht von PiNAS stammen, niemals anfassen
  if id "$name" &>/dev/null; then
    local uid gecos
    uid="$(id -u "$name")"
    gecos="$(getent passwd "$name" | cut -d: -f5)"
    if (( uid < 1000 )) && [[ "$gecos" != "$MARK" ]]; then
      die "Systemkonto '$name' darf nicht verwendet werden"
    fi
  fi
}

read_password() {
  IFS= read -r pw || true
  (( ${#pw} >= 8 )) || die "Passwort zu kurz"
}

set_smb_password() {
  printf '%s\n%s\n' "$pw" "$pw" | smbpasswd -s -a "$name" >/dev/null
  smbpasswd -e "$name" >/dev/null
}

# ---------------------------------------------------------------- Laufwerk

set_setting() {
  touch "$SETTINGS"
  if grep -q "^$1=" "$SETTINGS"; then
    sed -i "s|^$1=.*|$1=$2|" "$SETTINGS"
  else
    echo "$1=$2" >> "$SETTINGS"
  fi
}

check_layout() { [[ "$1" == "folder" || "$1" == "root" ]] || die "Unbekannte Ordner-Aufteilung: $1"; }
users_dir()  { [[ "$1" == "root" ]] && echo "$2/.pinas/users" || echo "$2/users"; }
shared_dir() { [[ "$1" == "root" ]] && echo "$2" || echo "$2/shared"; }

AUDIT_FLAG="/var/lib/pinas/samba-audit"  # vorhanden = Netzlaufwerk-Zugriffe protokollieren

vfs_module() {
  compgen -G "/usr/lib/*/samba/vfs/$1.so" >/dev/null || compgen -G "/usr/lib/samba/vfs/$1.so" >/dev/null
}

samba_config() {
  local veto="/.pinas-upload-*/"
  # Im Modus "root" PiNAS- und Systemordner in „Gemeinsam“ verbergen
  [[ "$PINAS_SHARED_MODE" == "root" ]] && veto="$veto.pinas/.tmp/lost+found/System Volume Information/\$RECYCLE.BIN/"
  # Papierkorb fürs Netzlaufwerk nur, wenn das Samba-Modul "recycle" vorhanden ist –
  # sonst ließen sich die Freigaben nicht mehr öffnen
  local recycle='/^@R@/d' audit='/^@A@/d' vfs=""
  if vfs_module recycle; then
    recycle='s/^@R@//'
    vfs="recycle"
  fi
  # Ereignis-Protokoll fürs Netzlaufwerk (Admin-Option im Dashboard, siehe samba-audit).
  # full_audit steht vor recycle, damit es das Löschen sieht, bevor recycle es in den Papierkorb umleitet
  if [[ -e "$AUDIT_FLAG" ]] && vfs_module full_audit; then
    audit='s/^@A@//'
    vfs="full_audit${vfs:+ $vfs}"
  fi
  local vfsline='/^@V@/d'
  [[ -n "$vfs" ]] && vfsline="s/^@V@//;s/@VFS@/$vfs/"
  sed -e "s|@USERS_DIR@|$(users_dir "$PINAS_SHARED_MODE" "$DATA")|g" \
      -e "s|@SHARED_DIR@|$(shared_dir "$PINAS_SHARED_MODE" "$DATA")|g" \
      -e "s|@VETO@|$veto|g" -e "$recycle" -e "$audit" -e "$vfsline" "$SAMBA_TEMPLATE" > /etc/samba/pinas.conf
  testparm -s >/dev/null 2>&1 || die "Samba-Konfiguration fehlerhaft"
  systemctl try-reload-or-restart smbd 2>/dev/null || true
}

# Ordner anlegen; Rechte nur auf ext4 setzen (NTFS/exFAT regeln das über die Mount-Optionen)
prepare_dirs() {
  local base="$1" layout="$2" fstype="$3" u s
  u="$(users_dir "$layout" "$base")"
  s="$(shared_dir "$layout" "$base")"
  mkdir -p "$u" "$s" "$base/.tmp"
  if [[ "$fstype" == "ext4" ]]; then
    chown pinas:pinas "$base" "$base/.tmp" "$s" "$u"
    if [[ "$layout" == "root" ]]; then chown pinas:pinas "$base/.pinas"; fi
    chmod 0770 "$base" "$base/.tmp" "$s" "$u"
  fi
}

# fstab-Typ und Optionen je Dateisystem; nofail: Der Pi startet auch, wenn die Platte fehlt
mount_spec() {
  local common="noatime,nofail,x-systemd.device-timeout=15" ids
  ids="uid=$(id -u pinas),gid=$(id -g pinas),umask=007"
  case "$1" in
    ext4)  echo "ext4 defaults,$common" ;;
    ntfs)  echo "ntfs-3g defaults,$common,$ids,windows_names" ;;
    exfat) echo "exfat defaults,$common,$ids" ;;
    *) die "Dateisystem $1 wird nicht unterstützt" ;;
  esac
}

set_layout() {
  local new="$1" old="$PINAS_SHARED_MODE" old_u new_u fstype
  check_layout "$new"
  [[ "$new" == "$old" ]] && { samba_config; return; }
  old_u="$(users_dir "$old" "$DATA")"
  new_u="$(users_dir "$new" "$DATA")"
  fstype="$(findmnt -no FSTYPE -T "$DATA")"
  [[ "$fstype" == "fuseblk" ]] && fstype="ntfs"
  # Private Ordner mitnehmen (gleiche Platte: Verschieben dauert keine Sekunde)
  if [[ -d "$old_u" ]]; then
    mkdir -p "$(dirname "$new_u")"
    rmdir "$new_u" 2>/dev/null || true
    [[ -e "$new_u" ]] && die "Der Ordner $new_u existiert bereits und ist nicht leer"
    mv "$old_u" "$new_u"
  fi
  prepare_dirs "$DATA" "$new" "$fstype"
  set_setting PINAS_SHARED_MODE "$new"
  PINAS_SHARED_MODE="$new"
  samba_config
}

use_disk() {
  local dev="$1" mode="$2" layout="${3:-folder}" part fstype root_disk tmp uuid spec mtype mopts
  check_layout "$layout"
  [[ "$dev" =~ ^/dev/(sd[a-z]+[0-9]*|nvme[0-9]+n[0-9]+(p[0-9]+)?)$ ]] || die "Ungültiges Gerät: $dev"
  [[ -b "$dev" ]] || die "Gerät $dev nicht gefunden"

  root_disk="$(lsblk -no PKNAME "$(findmnt -no SOURCE /)")"
  local own_disk
  own_disk="$(lsblk -no PKNAME "$dev" | head -n1)"
  [[ -z "$own_disk" ]] && own_disk="${dev#/dev/}"
  [[ "$own_disk" != "$root_disk" && "${dev#/dev/}" != "$root_disk" ]] || die "Das Systemlaufwerk darf nicht verwendet werden"
  if lsblk -no MOUNTPOINT "$dev" | grep -q .; then
    die "$dev ist bereits eingehängt"
  fi

  case "$mode" in
    format)
      [[ "$(lsblk -dno TYPE "$dev")" == "disk" ]] || die "Zum Formatieren bitte die ganze Platte wählen"
      wipefs -a "$dev" >/dev/null
      printf 'label: gpt\n,,L\n' | sfdisk --quiet "$dev"
      udevadm settle
      [[ "$dev" =~ [0-9]$ ]] && part="${dev}p1" || part="${dev}1"
      for _ in 1 2 3 4 5; do [[ -b "$part" ]] && break; sleep 1; done
      mkfs.ext4 -q -F -L pinas "$part"
      fstype="ext4"
      ;;
    keep)
      [[ "$(lsblk -dno TYPE "$dev")" == "part" ]] || die "Bitte eine Partition wählen"
      fstype="$(blkid -s TYPE -o value "$dev" || true)"
      case "$fstype" in
        ext4|ntfs|exfat) ;;
        *) die "Nur ext4-, NTFS- und exFAT-Partitionen können übernommen werden (gefunden: ${fstype:-keins})" ;;
      esac
      part="$dev"
      ;;
    *) die "Unbekannter Modus: $mode" ;;
  esac

  uuid="$(blkid -s UUID -o value "$part")"
  [[ -n "$uuid" ]] || die "Keine UUID für $part gefunden"
  spec="$(mount_spec "$fstype")"
  mtype="${spec%% *}"
  mopts="${spec#* }"

  # Neue Platte probeweise einhängen und vorbereiten
  tmp="$(mktemp -d /mnt/pinas-new.XXXXXX)"
  local probe="${mopts//nofail,/}"
  probe="${probe//x-systemd.device-timeout=15,/}"  # nur für fstab gedacht
  if ! mount -t "$mtype" -o "$probe" "$part" "$tmp" 2>/dev/null; then
    rmdir "$tmp"
    if [[ "$fstype" == "ntfs" ]]; then
      die "Die Windows-Platte lässt sich nicht beschreiben. Wahrscheinlich wurde sie nicht sauber getrennt oder Windows-Schnellstart ist aktiv. Bitte an einem Windows-PC einstecken, dort „Hardware sicher entfernen“ wählen (oder Schnellstart in den Energieoptionen ausschalten) und erneut versuchen."
    fi
    die "Die Partition $part ließ sich nicht einhängen."
  fi
  prepare_dirs "$tmp" "$layout" "$fstype"
  # Liegen die NAS-Daten bisher auf der SD-Karte, werden sie auf die Platte kopiert.
  # (Beim Wechsel zwischen zwei Platten wird nichts kopiert.)
  if ! mountpoint -q "$DATA"; then
    local rs=(-rt --ignore-existing --exclude '.pinas-upload-*')
    [[ "$fstype" == "ext4" ]] && rs=(-a --ignore-existing --exclude '.pinas-upload-*')
    local src_u src_s
    src_u="$(users_dir "$PINAS_SHARED_MODE" "$DATA")"
    src_s="$(shared_dir "$PINAS_SHARED_MODE" "$DATA")"
    if [[ -d "$src_u" ]]; then
      rsync "${rs[@]}" "$src_u/" "$(users_dir "$layout" "$tmp")/"
    fi
    if [[ -d "$src_s" && "$src_s" != "$DATA" ]]; then
      rsync "${rs[@]}" "$src_s/" "$(shared_dir "$layout" "$tmp")/"
    fi
    if [[ "$fstype" == "ext4" ]]; then
      chown -R pinas:pinas "$(users_dir "$layout" "$tmp")" "$(shared_dir "$layout" "$tmp")"
    fi
  fi
  umount "$tmp"
  rmdir "$tmp"

  # Umschalten
  systemctl stop smbd || true
  if mountpoint -q "$DATA"; then
    umount "$DATA" || umount -l "$DATA"
  fi
  sed -i "\|[[:space:]]${DATA}[[:space:]]|d" /etc/fstab
  local pass=0
  [[ "$fstype" == "ext4" ]] && pass=2
  echo "UUID=$uuid  $DATA  $mtype  $mopts  0  $pass" >> /etc/fstab
  systemctl daemon-reload
  mount "$DATA"
  set_setting PINAS_SHARED_MODE "$layout"
  PINAS_SHARED_MODE="$layout"
  samba_config
  systemctl start smbd || true
}

# ---------------------------------------------------------------- Ein/Aus

RUN_DIR="/run/pinas"
DISK_OFF_FLAG="$RUN_DIR/disk-off"
POWER_STATE="$RUN_DIR/power.json"
SAFE_DELAY=120   # Sekunden zwischen Festplatte aus und Herunterfahren

# Festplatte sauber abmelden: Netzlaufwerk stoppen, aushängen, Motor anhalten
disk_off() {
  mountpoint -q "$DATA" || die "Es ist keine Festplatte eingehängt."
  local src disk root_disk
  src="$(findmnt -no SOURCE "$DATA")"
  [[ "$src" == /dev/* ]] || die "Die Festplatte wurde nicht gefunden."
  disk="$(lsblk -no PKNAME "$src" | head -n1)"
  disk="/dev/${disk:-${src#/dev/}}"
  root_disk="/dev/$(lsblk -no PKNAME "$(findmnt -no SOURCE /)")"
  [[ "$disk" != "$root_disk" ]] || die "Die NAS-Daten liegen auf der SD-Karte – da gibt es nichts auszuschalten."
  sync
  systemctl stop smbd || true
  if ! umount "$DATA"; then
    systemctl start smbd || true
    die "Die Festplatte wird gerade noch benutzt (z. B. ein Kopiervorgang). Bitte kurz warten und erneut versuchen."
  fi
  sync
  # Motor anhalten; USB-Gehäuse verstehen je nach Modell den ATA- oder den SCSI-Befehl
  hdparm -y "$disk" >/dev/null 2>&1 || sdparm --readonly --command=stop "$disk" >/dev/null 2>&1 || true
  mkdir -p "$RUN_DIR"
  date +%s > "$DISK_OFF_FLAG"
  chmod 0644 "$DISK_OFF_FLAG"
}

disk_on() {
  rm -f "$DISK_OFF_FLAG"
  mountpoint -q "$DATA" || mount "$DATA" || die "Die Festplatte ließ sich nicht wieder einhängen. Ist sie noch angeschlossen?"
  systemctl start smbd || true
}

# Herunterfahren/Neustart zeitversetzt, damit die Weboberfläche noch antworten kann
schedule_power() {
  local action="$1" delay="$2" label="$3"
  cancel_power
  systemd-run --quiet --unit=pinas-power --on-active="${delay}s" --timer-property=AccuracySec=1s \
    /bin/systemctl "$action" || die "Konnte $label nicht planen."
  mkdir -p "$RUN_DIR"
  printf '{"action": "%s", "at": %s}\n' "$label" "$(( $(date +%s) + delay ))" > "$POWER_STATE"
  chmod 0644 "$POWER_STATE"
}

cancel_power() {
  systemctl stop pinas-power.timer pinas-power.service 2>/dev/null || true
  systemctl reset-failed pinas-power.timer pinas-power.service 2>/dev/null || true
  rm -f "$POWER_STATE"
}

power() {
  case "$1" in
    shutdown)      schedule_power poweroff 5 shutdown ;;
    reboot)        schedule_power reboot 5 reboot ;;
    update-reboot) schedule_power reboot 15 update-reboot ;;  # nach einem erfolgreichen Update
    safe-shutdown) disk_off; schedule_power poweroff "$SAFE_DELAY" safe-shutdown ;;
    disk-off)      disk_off ;;
    disk-on)       disk_on ;;
    cancel)        cancel_power ;;
    *) die "Unbekannte Aktion: $1" ;;
  esac
}

# ---------------------------------------------------------------- Werkseinstellungen

STATE_DIR="/var/lib/pinas"
RESET_STATUS="$RUN_DIR/reset.json"

# Startet das Zurücksetzen als eigenen Dienst – es stoppt die Weboberfläche, die es aufgerufen hat
factory_reset() {
  local mode="$1"
  [[ "$mode" == "keep" || "$mode" == "wipe" ]] || die "Unbekannter Modus: $mode"
  systemctl is-active --quiet pinas-reset && die "Das Zurücksetzen läuft bereits."
  systemctl reset-failed pinas-reset 2>/dev/null || true
  mkdir -p "$RUN_DIR"
  printf '{"state": "running", "mode": "%s"}\n' "$mode" > "$RESET_STATUS"
  chmod 0644 "$RESET_STATUS"
  systemd-run --quiet --unit=pinas-reset --collect --description="PiNAS auf Werkseinstellungen" \
    /usr/local/sbin/pinas-helper factory-reset-run "$mode" || die "Zurücksetzen konnte nicht gestartet werden."
}

factory_reset_run() {
  local mode="$1" src disk u
  # Bei einem Fehler die Dienste trotzdem wieder starten, damit PiNAS erreichbar bleibt
  trap 'printf "{\"state\": \"failed\", \"mode\": \"%s\"}\n" "$mode" > "$RESET_STATUS"; systemctl start smbd pinas || true' ERR
  cancel_power
  systemctl stop pinas smbd || true

  # NAS-Benutzer entfernen (nur Konten, die PiNAS selbst angelegt hat)
  while IFS=: read -r u _ _ _ gecos _; do
    [[ "$gecos" == "$MARK" ]] || continue
    smbpasswd -x "$u" &>/dev/null || true
    userdel "$u" &>/dev/null || true
  done < <(getent passwd)

  # Festplatte abmelden und aus /etc/fstab austragen; bei "wipe" zusätzlich leeren
  rm -f "$DISK_OFF_FLAG"
  if mountpoint -q "$DATA"; then
    src="$(findmnt -no SOURCE "$DATA")"
    disk="$(lsblk -no PKNAME "$src" | head -n1)"
    disk="/dev/${disk:-${src#/dev/}}"
    umount "$DATA" || umount -l "$DATA"
    if [[ "$mode" == "wipe" && "$disk" == /dev/sd* ]]; then
      # Dateisystem-Kennungen und Partitionstabelle löschen – die Platte ist danach leer
      lsblk -lnpo NAME "$disk" | tac | while read -r p; do wipefs -a "$p" >/dev/null 2>&1 || true; done
      udevadm settle || true
    fi
  fi
  sed -i "\|[[:space:]]${DATA}[[:space:]]|d" /etc/fstab
  systemctl daemon-reload
  # Lagen die NAS-Daten auf der SD-Karte, werden bei "wipe" auch diese gelöscht
  if [[ "$mode" == "wipe" ]] && ! mountpoint -q "$DATA"; then
    find "$DATA" -xdev -mindepth 1 -delete
  fi

  # Einstellungen, Datenbank, Dashboard, Energiesparen … löschen. Die Gesamtbetriebszeit
  # (history.json) gehört zum Gerät und bleibt – wie ein Betriebsstundenzähler
  find "$STATE_DIR" -mindepth 1 ! -name history.json -delete
  install -d -m 0700 -o pinas -g pinas "$STATE_DIR" "$STATE_DIR/updates"
  rm -rf /var/lib/pinas-update/staged /var/lib/pinas-update/staged.json
  set_setting PINAS_SHARED_MODE folder
  PINAS_SHARED_MODE="folder"
  prepare_dirs "$DATA" folder ext4
  samba_config || true

  systemctl start smbd pinas || true
  printf '{"state": "done", "mode": "%s"}\n' "$mode" > "$RESET_STATUS"
}

# ---------------------------------------------------------------- Befehle

cmd="${1:-}"
case "$cmd" in
  add-user|set-password|delete-user)
    [[ $# -eq 2 ]] || die "Aufruf: pinas-helper $cmd NAME"
    name="$2"
    check_user_name
    ;;
  private-access)
    [[ $# -eq 3 && ( "$3" == "on" || "$3" == "off" ) ]] || die "Aufruf: pinas-helper private-access NAME on|off"
    name="$2"
    check_user_name
    id "$name" &>/dev/null || die "Unbekannter Benutzer"
    getent group "$PRIVATE_GROUP" >/dev/null || groupadd --system "$PRIVATE_GROUP"
    if [[ "$3" == "on" ]]; then
      usermod -aG "$PRIVATE_GROUP" "$name"
    else
      gpasswd -d "$name" "$PRIVATE_GROUP" &>/dev/null || true
    fi
    exit 0
    ;;
  use-disk)
    [[ $# -eq 3 || $# -eq 4 ]] || die "Aufruf: pinas-helper use-disk GERÄT format|keep [folder|root]"
    use_disk "$2" "$3" "${4:-folder}"
    exit 0
    ;;
  set-layout)
    [[ $# -eq 2 ]] || die "Aufruf: pinas-helper set-layout folder|root"
    set_layout "$2"
    exit 0
    ;;
  samba-config)
    samba_config
    exit 0
    ;;
  samba-audit)
    [[ $# -eq 2 && ( "$2" == "on" || "$2" == "off" ) ]] || die "Aufruf: pinas-helper samba-audit on|off"
    if [[ "$2" == "on" ]]; then
      vfs_module full_audit || die "Das Samba-Modul full_audit ist nicht installiert."
      install -m 0644 -o root -g root /dev/null "$AUDIT_FLAG"
    else
      rm -f "$AUDIT_FLAG"
    fi
    samba_config
    exit 0
    ;;
  disk-sleep)
    [[ $# -eq 1 ]] || die "Aufruf: pinas-helper disk-sleep"
    exec /usr/local/sbin/pinas-diskpower --now
    ;;
  factory-reset|factory-reset-run)
    [[ $# -eq 2 ]] || die "Aufruf: pinas-helper $cmd keep|wipe"
    [[ "$2" == "keep" || "$2" == "wipe" ]] || die "Unbekannter Modus: $2"
    if [[ "$cmd" == "factory-reset" ]]; then factory_reset "$2"; else factory_reset_run "$2"; fi
    exit 0
    ;;
  power)
    [[ $# -eq 2 ]] || die "Aufruf: pinas-helper power AKTION"
    power "$2"
    exit 0
    ;;
  update-stage)
    [[ $# -eq 2 ]] || die "Aufruf: pinas-helper update-stage DATEI"
    exec /usr/local/sbin/pinas-update stage "$2"
    ;;
  update-apply|update-rollback|update-discard)
    [[ $# -eq 1 ]] || die "Aufruf: pinas-helper $cmd"
    exec /usr/local/sbin/pinas-update "${cmd#update-}"
    ;;
  *)
    die "Unbekannter Befehl: $cmd" ;;
esac

case "$cmd" in
  add-user)
    read_password
    if ! id "$name" &>/dev/null; then
      useradd --system --no-create-home --shell /usr/sbin/nologin --comment "$MARK" "$name"
    fi
    usermod -aG "$GROUP" "$name"
    set_smb_password
    ;;
  set-password)
    read_password
    id "$name" &>/dev/null || die "Unbekannter Benutzer"
    set_smb_password
    ;;
  delete-user)
    smbpasswd -x "$name" &>/dev/null || true
    if id "$name" &>/dev/null; then
      gpasswd -d "$name" "$GROUP" &>/dev/null || true
      if [[ "$(getent passwd "$name" | cut -d: -f5)" == "$MARK" ]]; then
        userdel "$name"
      fi
    fi
    ;;
esac
