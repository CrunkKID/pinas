def _status_text() -> tuple[str, str]:
    reason = busy_reason()
    if reason == "update":
        return "Gerade läuft ein Update", "PiNAS installiert eine neue Version. Das dauert meist nur ein paar Minuten."
    if reason == "reset":
        return "PiNAS wird zurückgesetzt", "Das kann ein paar Minuten dauern."
    if reason == "start":
        return "PiNAS startet gerade", "In ein bis zwei Minuten ist es wieder erreichbar."
    props = unit_props("pinas")
    if props.get("SubState") in ("auto-restart", "start") or props.get("ActiveState") == "activating":
        return "PiNAS antwortet gerade nicht", ("Die Weboberfläche startet immer wieder neu. Netzlaufwerk und Dateien sind davon "
                                                "meist nicht betroffen. Unten kannst du den Fehlerbericht holen und PiNAS neu starten.")
    return "PiNAS antwortet gerade nicht", ("Die Weboberfläche läuft nicht. Netzlaufwerk und Dateien sind davon meist nicht "
                                            "betroffen. Unten kannst du den Fehlerbericht holen und PiNAS neu starten.")


def _page(status: int, error: str = "", notice: str = "") -> tuple[int, list, bytes]:
    title, text = _status_text()
    previous = previous_version()
    rollback = ""
    if previous:
        label = html.escape(f"Zurück zu Version {previous}" if previous != "?" else "Zurück zur vorherigen Version")
        rollback = (f'<button class="second" name="aktion" value="zurueck" onclick="return confirm(\'PiNAS auf die vorherige '
                    f'Version zurücksetzen und danach neu starten? Deine Dateien bleiben erhalten.\')">{label}</button>')
    body = _PAGE.format(title=html.escape(title), text=html.escape(text), open=" open" if error else "", rollback=rollback,
                        notice=f'<p class="ok">{html.escape(notice)}</p>' if notice else "",
                        error=f'<p class="err">{html.escape(error)}</p>' if error else "")
    return status, [("Content-Type", "text/html; charset=utf-8")], body.encode()


def _system_action(action: str) -> tuple[int, list, bytes]:
    """Neustart oder vorherige Version; das Passwort ist da schon geprüft."""
    if busy_reason():  # Update, Zurücksetzen, Neustart: laufen schon, nichts dazwischenschieben
        return _page(409, "Gerade läuft schon etwas. Bitte warte ein paar Minuten und versuch es dann noch einmal.")
    if action == "neustart":
        failed = helper_cmd("power", "reboot")
        done, notice = "Neustart", "PiNAS startet jetzt neu. In ein bis zwei Minuten ist es wieder erreichbar."
    else:
        if not previous_version():
            return _page(409, "Es gibt keine vorherige Version, zu der PiNAS zurückkehren könnte.")
        failed = helper_cmd("update-rollback")
        done, notice = "Zurück zur vorherigen Version", "PiNAS kehrt zur vorherigen Version zurück und startet danach neu. Das dauert ein paar Minuten."
    if failed:
        record("rescue", f"Notfallseite: {done} hat nicht geklappt", failed, key=f"rescue|{action}|{failed}")
        return _page(500, f"Das hat nicht geklappt: {failed}")
    record("rescue", f"Notfallseite: {done} ausgelöst", level="warn", key=f"rescue|{action}|{int(time.time())}")
    return _page(200, notice=notice)


def respond(method: str, target: str, body: bytes, ip: str, accept: str) -> tuple[int, list, bytes]:
    """Antwort auf eine Anfrage. Immer 502, damit Skripte (transfer.js, update.html) es als Ausfall erkennen."""
    path = urllib.parse.urlsplit(target).path
    if path.startswith("/notfall/"):
        if web_up():  # Nur im Notfall aktiv: Läuft PiNAS, gilt wieder die normale Anmeldung
            return 303, [("Location", "/")], b""
        if path == "/notfall/aktion" and method == "POST":
            now = time.time()
            if _too_many(ip, now):
                return _page(429, "Zu viele Fehlversuche. Bitte in ein paar Minuten erneut versuchen.")
            form = urllib.parse.parse_qs(body.decode("utf-8", "replace"), max_num_fields=10)
            if not verify_admin(form.get("username", [""])[0], form.get("password", [""])[0]):
                _note_fail(ip, now)
                return _page(401, "Benutzername oder Passwort falsch, oder das Konto ist kein Administrator.")
            action = form.get("aktion", ["bericht"])[0]
            if action in ("neustart", "zurueck"):
                return _system_action(action)
            name = "pinas-fehlerbericht-" + time.strftime("%Y-%m-%d-%H%M") + ".txt"
            return 200, [("Content-Type", "text/plain; charset=utf-8"),
                         ("Content-Disposition", f'attachment; filename="{name}"')], report().encode()
        return _page(502)
    if method == "GET" and "text/html" in accept:
        return _page(502)
    return 502, [("Content-Type", "application/json")], json.dumps(
        {"error": "PiNAS antwortet gerade nicht. Bitte gleich noch einmal versuchen."}, ensure_ascii=False).encode()


class Handler(BaseHTTPRequestHandler):
    server_version = "PiNAS"
    sys_version = ""
    timeout = 60

    def _handle(self) -> None:
        body = b""
        length = self.headers.get("Content-Length", "0")
        # Große Uploads, die wegen des Ausfalls hier landen, gar nicht erst lesen
        if self.path.startswith("/notfall/") and length.isdigit() and int(length) <= 4096:
            body = self.rfile.read(int(length))
        ip = self.headers.get("X-Forwarded-For", self.client_address[0])
        status, headers, data = respond(self.command, self.path, body, ip, self.headers.get("Accept", ""))
        self.send_response(status)
        for key, value in headers:
            self.send_header(key, value)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True
        if self.command != "HEAD":
            self.wfile.write(data)

    do_GET = do_POST = do_PUT = do_DELETE = do_HEAD = _handle

    def log_message(self, format, *args) -> None:  # noqa: A002 – die Adressen enthalten Dateinamen
        pass


def serve() -> None:
    signal.signal(signal.SIGTERM, _stop)
    boot_check()
    threading.Thread(target=watch_loop, name="pinas-watch", daemon=True).start()
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "serve":
        serve()
    elif cmd == "report":
        sys.stdout.buffer.write(report().encode())
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
